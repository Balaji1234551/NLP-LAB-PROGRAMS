      "source": [
        "\n",
        "import nltk\n",
        "from nltk.stem import PorterStemmer\n",
        "\n",
        "stemmer = PorterStemmer()\n",
        "\n",
        "words = [\"playing\", \"played\", \"plays\", \"running\",\n",
        "         \"studies\", \"happiness\", \"connected\"]\n",
        "\n",
        "for word in words:\n",
        "    print(word, \"->\", stemmer.stem(word))\n"
      ]
    }
  ]
