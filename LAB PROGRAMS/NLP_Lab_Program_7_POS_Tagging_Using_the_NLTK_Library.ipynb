      "source": [
        "import nltk\n",
        "\n",
        "nltk.download('punkt')\n",
        "nltk.download('punkt_tab')\n",
        "nltk.download('averaged_perceptron_tagger_eng')\n",
        "\n",
        "text = \"The cat runs quickly\"\n",
        "\n",
        "words = nltk.word_tokenize(text)\n",
        "tags = nltk.pos_tag(words)\n",
        "\n",
        "print(tags)"
